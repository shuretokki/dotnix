#!/usr/bin/env bash
#MISE description="Show the system, theme and Hyprland look like fastfetch, with the installed programs"
#USAGE arg "[host]" help="Host name" default="desktop"
#USAGE flag "-p --packages" help="Also list every installed package"
set -euo pipefail

host="${usage_host?}"
opts=modules/home-manager/hyprland/options
section() { printf '\n\033[1;34m%s\033[0m\n' "$1"; }

fastfetch

data=$(nix eval --json ".#nixosConfigurations.${host}.config" --apply '
c: let
  hm = c.home-manager.users.${builtins.head (builtins.attrNames c.home-manager.users)};
  names = ps: builtins.sort builtins.lessThan (map (p: p.pname or (builtins.parseDrvName p.name).name) ps);
  hypr = hm.wayland.windowManager.hyprland;
in {
  plugins = names hypr.plugins;
  pluginSettings = hypr.settings.config.plugin or { };
  system = names c.environment.systemPackages;
  user = names hm.home.packages;
}')

section "Hyprland look"
awk '/^[[:space:]]+(rounding|rounding_power|gaps_in|gaps_out|border_size|active_opacity|inactive_opacity) *=/ {gsub(/^[ \t]+/, ""); gsub(/,$/, ""); print "  " $0}' "$opts/look.lua"
awk '/shadow = \{/ {on=1; next} on && /^[[:space:]]+\},?$/ {on=0} on && /enabled *=/ {gsub(/^[ \t]+/, ""); gsub(/,$/, ""); print "  shadow " $0; exit}' "$opts/look.lua"
awk '/blur = \{/ {on=1; next} on && /enabled *=/ {gsub(/^[ \t]+/, ""); gsub(/,$/, ""); print "  blur " $0; exit}' "$opts/blur.lua"
grep -h 'scale' "hosts/${host}/monitor.lua" 2>/dev/null | sed 's/^ */  monitor /; s/,$//' || true

section "Hyprland plugins"
echo "$data" | jq -r '.plugins[] | "  " + .'
echo "$data" | jq -r '.pluginSettings | to_entries[] | "  \(.key): " + (.value | tostring)'

section "Programs"
echo "$data" | jq -r '"  system packages: \(.system | length)", "  user packages:   \(.user | length)"'
if [ "${usage_packages:-false}" = "true" ]; then
  echo "$data" | jq -r '"  -- system", (.system | join(" ")), "  -- user", (.user | join(" "))' | fold -s -w 100
fi
